####################################
# Application
####################################
APP_NAME=Library Management System
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Library/public
APP_TIMEZONE=Asia/Yangon

####################################
# Database
####################################
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library
DB_USER=root
DB_PASS=

####################################
# Session
####################################
SESSION_NAME=library_session
SESSION_LIFETIME=120

####################################
# Mail (PHPMailer)
####################################
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Library Management System"

####################################
# Stripe
####################################
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

####################################
# Upload
####################################
MAX_UPLOAD_SIZE=5242880

####################################
# Logging
####################################
LOG_LEVEL=debug
LOG_PATH=storage/logs/error.log